---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import FilterBox from "@/components/FilterBox.astro";
import JobCard from "@/components/JobCard.astro";

const jobs = (await getCollection("jobs")).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime(),
);

const searchIndex = jobs.map((job) => ({
  title: job.data.title,
  slug: job.slug,
  publishedDate: job.data.publishedDate,
  author: job.data.author,
  categories: job.data.categories,
  categorySlugs: job.data.categorySlugs,
  postCount: job.data.postCount,
  deadline: job.data.deadline,
  image: job.data.image,
  excerpt: job.data.excerpt,
}));
---

<BaseLayout title="Search Jobs - GovtJobBD" description="GovtJobBD job search page." canonicalPath="/search/">
  <FilterBox />
  <main class="container search-page">
    <div class="search-results-header" id="search-summary" aria-live="polite">
      সব চাকরির ফলাফল দেখানো হচ্ছে।
    </div>

    <div class="post-list" id="search-results">
      {jobs.map((job) => <JobCard {...job.data} slug={job.slug} />)}
    </div>

    <article class="page-card search-empty" id="search-empty" hidden>
      <h1>🔎 কোনো চাকরির সার্কুলার পাওয়া যায়নি</h1>
      <p>💡 ভিন্ন কিওয়ার্ড দিয়ে আবার সার্চ করুন</p>
    </article>

    <script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)}></script>
    <script is:inline>
      const jobs = JSON.parse(document.getElementById("search-data").textContent || "[]");
      const form = document.querySelector(".filter-box");
      const results = document.getElementById("search-results");
      const summary = document.getElementById("search-summary");
      const empty = document.getElementById("search-empty");

      const banglaDigits = "০১২৩৪৫৬৭৮৯";
      const escapeHtml = (value) =>
        String(value ?? "").replace(/[&<>"']/g, (char) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[char]);

      const normalizeText = (value) =>
        String(value ?? "")
          .toLowerCase()
          .replace(/[০-৯]/g, (digit) => String(banglaDigits.indexOf(digit)))
          .replace(/\s+/g, " ")
          .trim();

      const formatDate = (date) =>
        new Intl.DateTimeFormat("en-GB", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }).format(new Date(date));

      const renderJob = (job) => `
        <article class="job-card post type-post status-publish format-standard has-post-thumbnail hentry resize-featured-image" itemtype="https://schema.org/CreativeWork" itemscope>
          <div class="inside-article">
            <header class="entry-header">
              <h2 class="entry-title" itemprop="headline">
                <a href="/${escapeHtml(job.slug)}/" rel="bookmark">${escapeHtml(job.title)}</a>
              </h2>
              <div class="entry-meta">
                <span class="posted-on"><time class="entry-date published" datetime="${escapeHtml(job.publishedDate)}" itemprop="datePublished">${escapeHtml(formatDate(job.publishedDate))}</time></span>
                <span class="byline"> by <span class="author vcard" itemprop="author" itemtype="https://schema.org/Person" itemscope><span class="author-name" itemprop="name">${escapeHtml(job.author)}</span></span></span>
              </div>
            </header>
            <div class="post-image">
              <a href="/${escapeHtml(job.slug)}/">
                <img src="${escapeHtml(job.image)}" alt="${escapeHtml(job.title)}" width="768" height="427" loading="lazy" itemprop="image" />
              </a>
            </div>
            <div class="job-info-box job-vacancy">
              <div class="job-label">পদের সংখ্যা:</div>
              <div class="job-value">${escapeHtml(job.postCount)}</div>
            </div>
            <div class="job-info-box job-deadline">
              <div class="job-label">আবেদনের শেষ তারিখ:</div>
              <div class="job-value">${escapeHtml(job.deadline)}</div>
            </div>
            <div class="entry-summary" itemprop="text">
              <p> ... <a title="${escapeHtml(job.title)}" class="read-more" href="/${escapeHtml(job.slug)}/" aria-label="Read more about ${escapeHtml(job.title)}">বিস্তারিত পড়ুন</a></p>
            </div>
            <footer class="entry-meta entry-footer" aria-label="Entry meta">
              <span class="cat-links">
                <span class="gp-icon icon-categories" aria-hidden="true">
                  <svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M0 112c0-26.51 21.49-48 48-48h110.014a48 48 0 0 1 43.592 27.907l12.349 26.791A16 16 0 0 0 228.486 128H464c26.51 0 48 21.49 48 48v224c0 26.51-21.49 48-48 48H48c-26.51 0-48-21.49-48-48V112z"></path></svg>
                </span>
                <span class="screen-reader-text">Categories </span>
                ${job.categories.map((category, index) => `<a href="/category/${escapeHtml(job.categorySlugs[index])}/" rel="category tag">${escapeHtml(category)}</a>${index < job.categories.length - 1 ? "<span>,&nbsp;</span>" : ""}`).join("")}
              </span>
            </footer>
          </div>
        </article>
      `;

      const applyFilters = () => {
        const params = new URLSearchParams(window.location.search);
        const q = normalizeText(params.get("q"));

        if (form) {
          form.elements.namedItem("q").value = params.get("q") || "";
        }

        const filtered = jobs.filter((job) => {
          if (!q) return true;
          const haystack = normalizeText([
            job.title,
            job.excerpt,
            job.postCount,
            job.deadline,
            job.categories.join(" "),
            job.categorySlugs.join(" "),
          ].join(" "));
          return haystack.includes(q);
        });

        results.innerHTML = filtered.map(renderJob).join("");
        empty.hidden = filtered.length > 0;

        summary.innerHTML = q
          ? `📄 ${filtered.length}টি চাকরির সার্কুলার পাওয়া গেছে`
          : `📄 সব চাকরির সার্কুলার দেখানো হচ্ছে (${filtered.length}টি)`;
      };

      if (form) {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const params = new URLSearchParams(new FormData(form));
          for (const [key, value] of [...params.entries()]) {
            if (!value) params.delete(key);
          }
          const query = params.toString();
          history.replaceState(null, "", query ? `/search/?${query}` : "/search/");
          applyFilters();
        });
      }

      applyFilters();
    </script>
  </main>
</BaseLayout>
