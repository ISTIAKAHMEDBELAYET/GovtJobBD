---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JobCard from "@/components/JobCard.astro";
import Pagination from "@/components/Pagination.astro";
import Sidebar from "@/components/Sidebar.astro";

export async function getStaticPaths() {
  const postsPerPage = 10;
  const allJobs = (await getCollection("jobs")).sort(
    (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime(),
  );
  const totalPages = Math.ceil(allJobs.length / postsPerPage);

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * postsPerPage;

    return {
      params: { page: String(currentPage) },
      props: {
        currentPage,
        totalPages,
        jobs: allJobs.slice(start, start + postsPerPage),
      },
    };
  });
}

const { currentPage, totalPages, jobs } = Astro.props;
---

<BaseLayout title={`চাকরির খবর - Page ${currentPage} - GovtJobBD`} description="GovtJobBD paginated job circular archive." canonicalPath={`/page/${currentPage}/`}>
  <main class="container" id="content">
    <div class="content-grid">
      <div>
        <div class="post-list">
          {jobs.map((job) => <JobCard {...job.data} slug={job.slug} />)}
        </div>
        <Pagination currentPage={currentPage} totalPages={totalPages} />
      </div>
      <Sidebar />
    </div>
  </main>
</BaseLayout>
