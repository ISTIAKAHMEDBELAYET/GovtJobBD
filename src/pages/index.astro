---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JobCard from "@/components/JobCard.astro";
import Pagination from "@/components/Pagination.astro";
import Sidebar from "@/components/Sidebar.astro";
import FilterBox from "@/components/FilterBox.astro";
import { site } from "@/data/site";

const jobs = (await getCollection("jobs")).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime(),
);

const postsPerPage = 10;
const totalPages = Math.ceil(jobs.length / postsPerPage);
const currentJobs = jobs.slice(0, postsPerPage);
---

<BaseLayout title={site.title} description={site.description}>
  <FilterBox />
  <main class="container" id="content">
    <div class="content-grid">
      <div>
        <div class="post-list">
          {currentJobs.map((job) => <JobCard {...job.data} slug={job.slug} />)}
        </div>
        <Pagination currentPage={1} totalPages={totalPages} />
      </div>
      <Sidebar />
    </div>
  </main>
</BaseLayout>
