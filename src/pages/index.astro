---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JobCard from "@/components/JobCard.astro";
import Pagination from "@/components/Pagination.astro";
import Sidebar from "@/components/Sidebar.astro";
import { site } from "@/data/site";

const jobs = (await getCollection("jobs")).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime(),
);
---

<BaseLayout title={site.title} description={site.description}>
  <main class="container" id="content">
    <div class="content-grid">
      <div>
        <div class="post-list">
          {jobs.slice(0, 6).map((job) => <JobCard {...job.data} slug={job.slug} />)}
        </div>
        <Pagination />
      </div>
      <Sidebar />
    </div>
  </main>
</BaseLayout>
