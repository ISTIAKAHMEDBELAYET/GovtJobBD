---
interface Props {
  title?: string;
  items: { label: string; href: string }[];
}

const { title = "আরও দেখুন", items } = Astro.props;
---

<section class="see-more">
  <h2 class="see-more__title">{title}</h2>
  <ul class="see-more__list">
    {items.map((item) => <li><a href={item.href}><span>{item.label}</span><span aria-hidden="true">›</span></a></li>)}
  </ul>
</section>
