---
import { categories } from "@/data/site";
---

<aside class="sidebar" aria-label="Sidebar">
  <section class="sidebar-widget">
    <h2 class="widget-title">জব ক্যাটাগরি</h2>
    <ul class="sidebar-list">
      {categories.map((category) => <li><a href={`/category/${category.slug}/`}>{category.name}</a></li>)}
    </ul>
  </section>
</aside>
