<section class="filter-section">
  <div class="container">
    <form class="filter-box" action="/search/" method="get">
      <div class="field filter-keyword">
        <label class="sr-only" for="keyword">কিওয়ার্ড লিখে চাকরি খুঁজুন</label>
        <input id="keyword" type="search" name="q" placeholder="কিওয়ার্ড লিখে চাকরি খুঁজুন" />
      </div>
      <button class="filter-submit" type="submit">সার্চ করুন</button>
    </form>
  </div>
</section>
