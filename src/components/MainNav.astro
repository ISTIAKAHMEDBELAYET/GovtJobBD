---
import { navItems } from "@/data/site";

const mobileItems = navItems.flatMap((item) => [item, ...(item.children ?? [])]);
---

<nav class="main-navigation" aria-label="Primary navigation">
  <div class="container main-navigation__inner">
    <a class="mobile-nav-brand" href="/" aria-label="GovtJobBD home">
      <img src="/images/logo.svg" alt="GovtJobBD" width="62" height="62" />
    </a>
    <ul class="nav-list">
      {
        navItems.map((item, index) => (
          <li class={index === 0 ? "is-active" : ""}>
            <a href={item.href}>
              <span>{item.label}</span>
              {item.children && (
                <svg class="nav-caret" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z"></path>
                </svg>
              )}
            </a>
            {item.children && (
              <ul class="sub-menu">
                {item.children.map((child) => (
                  <li><a href={child.href}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
    <a class="search-toggle" href="/search/" aria-label="Search">
      <svg class="icon-search" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9.5 3a6.5 6.5 0 0 1 5.17 10.44l4.44 4.45-1.41 1.41-4.45-4.44A6.5 6.5 0 1 1 9.5 3Zm0 2a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9Z"></path>
      </svg>
    </a>
    <details class="mobile-menu">
      <summary class="mobile-menu-link" aria-label="Menu">
        <svg class="icon-menu" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16v2H4V6Zm0 5h16v2H4v-2Zm0 5h16v2H4v-2Z"></path>
        </svg>
        <span>Menu</span>
      </summary>
      <div class="mobile-menu-panel">
        {mobileItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
    </details>
  </div>
</nav>
