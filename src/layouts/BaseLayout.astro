---
import "../styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import MainNav from "@/components/MainNav.astro";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();
const ogImage = new URL("/images/job-placeholder.svg", site.url).toString();
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <style is:inline>
      * {
        box-sizing: border-box;
      }

      html {
        background: #f7f8f9;
        color: #222;
        scrollbar-gutter: stable;
      }

      body {
        margin: 0;
        min-width: 240px;
        font-family: "Noto Sans Bengali", "Hind Siliguri", "SolaimanLipi", Bangla, Arial, sans-serif;
        font-size: 17px;
        line-height: 1.65;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .site-header__inner {
        min-height: 116px;
      }

      .site-logo,
      .site-logo img {
        width: 260px;
        max-width: 72vw;
        aspect-ratio: 300 / 120;
      }

      .main-navigation {
        min-height: 60px;
      }

      .main-navigation__inner {
        min-height: 60px;
      }

      .container {
        width: min(1200px, calc(100% - 40px));
        margin-inline: auto;
      }

      .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 24px;
        padding: 10px 0 40px;
        align-items: start;
      }

      .post-list {
        display: grid;
        gap: 20px;
      }

      .inside-article {
        padding: 20px;
      }

      .entry-title {
        margin: 0 0 4px;
        font-size: clamp(1.45rem, 2.4vw, 2.15rem);
        line-height: 1.2;
      }

      .post-image {
        float: left;
        width: 350px;
        max-width: 46%;
        aspect-ratio: 768 / 427;
        margin: 0 26px 16px 0;
        background: #f2f4f6;
      }

      .post-image img {
        width: 100%;
        height: 100%;
        aspect-ratio: 768 / 427;
        object-fit: cover;
      }

      @media (max-width: 768px) {
        body {
          font-size: 13px;
          line-height: 1.55;
        }

        .container {
          width: min(100% - 16px, 1200px);
        }

        .content-grid {
          grid-template-columns: 1fr;
          gap: 12px;
          padding: 10px 0 20px;
        }

        .post-list {
          gap: 12px;
        }

        .inside-article {
          padding: 10px;
        }

        .entry-title {
          font-size: 17px;
          line-height: 1.18;
        }

        .post-image {
          float: none;
          width: min(100%, 196px);
          max-width: 100%;
          aspect-ratio: 768 / 427;
          margin: 6px auto 8px;
        }

        .site-header {
          display: none;
        }

        .main-navigation,
        .main-navigation__inner {
          min-height: 32px;
        }
      }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700;800&display=optional"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <MainNav />
    <slot />
    <Footer />
  </body>
</html>
