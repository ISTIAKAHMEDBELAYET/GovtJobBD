---
import "../styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import MainNav from "@/components/MainNav.astro";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();
const ogImage = new URL("/images/job-placeholder.svg", site.url).toString();
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/solaimanlipi.ttf" as="font" type="font/ttf" crossorigin />
    <style is:inline>
      @font-face {
        font-family: "SolaimanLipi";
        font-style: normal;
        font-weight: 400 800;
        font-display: block;
        src: url("/fonts/solaimanlipi.ttf") format("truetype");
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: #f7f8f9;
        color: #222;
        scrollbar-gutter: stable;
      }

      body {
        margin: 0;
        min-width: 240px;
        font-family: SolaimanLipi, Bangla, Arial, sans-serif;
        font-size: 18px;
        line-height: 1.5;
      }

      img {
        display: block;
        max-width: 100%;
        height: auto;
      }

      .site-header__inner {
        min-height: 95px;
      }

      .site-logo,
      .site-logo img {
        width: 260px;
        max-width: 72vw;
        aspect-ratio: 520 / 150;
      }

      .main-navigation {
        min-height: 60px;
      }

      .main-navigation__inner {
        min-height: 60px;
      }

      .container {
        width: min(1200px, calc(100% - 40px));
        margin-inline: auto;
      }

      .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 24px;
        padding: 10px 0 40px;
        align-items: start;
      }

      .post-list {
        display: grid;
        gap: 20px;
      }

      .inside-article {
        padding: 20px;
      }

      .entry-title {
        margin: 0 0 4px;
        font-size: 32px;
        line-height: 1.2;
      }

      .post-image {
        float: left;
        width: 350px;
        max-width: 46%;
        aspect-ratio: 768 / 427;
        margin: 0 26px 16px 0;
        background: #f2f4f6;
      }

      .post-image img {
        width: 100%;
        height: 100%;
        aspect-ratio: 768 / 427;
        object-fit: cover;
      }

      @media (max-width: 768px) {
        body {
          font-size: 18px;
          line-height: 1.5;
        }

        .container {
          width: min(100% - 16px, 1200px);
        }

        .content-grid {
          grid-template-columns: 1fr;
          gap: 12px;
          padding: 10px 0 20px;
        }

        .post-list {
          gap: 12px;
        }

        .inside-article {
          padding: 10px;
        }

        .entry-title {
          font-size: 32px;
          line-height: 1.2;
        }

        .post-image {
          float: none;
          width: min(100%, 196px);
          max-width: 100%;
          aspect-ratio: 768 / 427;
          margin: 6px auto 8px;
        }

        .site-header {
          display: none;
        }

        .main-navigation,
        .main-navigation__inner {
          min-height: 38px;
        }
      }

      .nav-search-bar {
        background: var(--accent);
        padding: 12px 0;
      }

      .nav-search-form {
        display: flex;
        gap: 8px;
        width: 100%;
        margin: 0 auto;
        max-width: 1200px;
        padding: 0 20px;
      }

      .nav-search-form input {
        flex: 1;
        height: 44px;
        padding: 0 16px;
        border: 2px solid rgba(255,255,255,0.3);
        border-radius: 4px;
        font-size: 16px;
        font-family: inherit;
        background: rgba(255,255,255,0.95);
      }

      .nav-search-form input:focus {
        outline: none;
        border-color: #fff;
        background: #fff;
      }

      .nav-search-form button {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 0 20px;
        height: 44px;
        background: rgba(0,0,0,0.25);
        color: #fff;
        border: none;
        border-radius: 4px;
        font-size: 16px;
        font-family: inherit;
        cursor: pointer;
        white-space: nowrap;
      }

      .nav-search-form button:hover {
        background: rgba(0,0,0,0.4);
      }

      .nav-search-form .icon-search {
        width: 20px;
        height: 20px;
        fill: currentColor;
      }

      @media (max-width: 768px) {
        .nav-search-form button span {
          display: none;
        }

        .nav-search-form button {
          padding: 0 14px;
        }
      }
    </style>
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <MainNav />
    <slot />
    <Footer />
  </body>
</html>
